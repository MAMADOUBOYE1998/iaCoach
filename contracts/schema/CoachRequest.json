{
  "$defs": {
    "Anthropometry": {
      "additionalProperties": false,
      "description": "Measured once at calibration. Used to normalise angles across body types.",
      "properties": {
        "arm_span_m": {
          "anyOf": [
            {
              "exclusiveMaximum": 2.6,
              "exclusiveMinimum": 0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arm Span M"
        },
        "height_m": {
          "exclusiveMaximum": 2.5,
          "exclusiveMinimum": 0.5,
          "title": "Height M",
          "type": "number"
        },
        "mass_kg": {
          "anyOf": [
            {
              "exclusiveMaximum": 250.0,
              "exclusiveMinimum": 20.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mass Kg"
        }
      },
      "required": [
        "height_m"
      ],
      "title": "Anthropometry",
      "type": "object"
    },
    "AthleteProfile": {
      "additionalProperties": false,
      "properties": {
        "anthropometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Anthropometry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "athlete_id": {
          "title": "Athlete Id",
          "type": "string"
        },
        "calibrations": {
          "items": {
            "$ref": "#/$defs/ExerciseCalibration"
          },
          "title": "Calibrations",
          "type": "array"
        },
        "constraints": {
          "description": "Injuries, equipment limits, schedule constraints. Free text.",
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "goals": {
          "items": {
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "level": {
          "enum": [
            "debutant",
            "intermediaire",
            "avance"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "athlete_id",
        "level"
      ],
      "title": "AthleteProfile",
      "type": "object"
    },
    "Exercise": {
      "description": "Exercises the movement classifier can emit.\n\nv1 ships pull-up end to end; the rest are declared so the classifier and the\ndatabase schema are stable before the rules exist.",
      "enum": [
        "pull_up",
        "chin_up",
        "dip",
        "push_up",
        "squat",
        "muscle_up",
        "l_sit",
        "unknown"
      ],
      "title": "Exercise",
      "type": "string"
    },
    "ExerciseCalibration": {
      "additionalProperties": false,
      "description": "Per-athlete, per-exercise reference range of motion.\n\nAll downstream thresholds are expressed as a fraction of this range, never as\nhard-coded angles. ``rom_min_deg``/``rom_max_deg`` are the joint angle\nextremes the athlete actually reached during a supervised calibration set.",
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "confidence": {
          "description": "Fraction of calibration frames above the visibility threshold.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "exercise": {
          "$ref": "#/$defs/Exercise"
        },
        "joint": {
          "description": "Joint driving the FSM, e.g. 'elbow'.",
          "title": "Joint",
          "type": "string"
        },
        "rom_max_deg": {
          "title": "Rom Max Deg",
          "type": "number"
        },
        "rom_min_deg": {
          "title": "Rom Min Deg",
          "type": "number"
        }
      },
      "required": [
        "exercise",
        "joint",
        "rom_min_deg",
        "rom_max_deg",
        "captured_at",
        "confidence"
      ],
      "title": "ExerciseCalibration",
      "type": "object"
    },
    "ExerciseEntry": {
      "additionalProperties": false,
      "description": "One entry of the structured exercise database.\n\nFrench field names because these strings are handed to the coach and shown to\nthe athlete verbatim; translating them at the boundary would only add a lossy\nstep. ``tags`` stays machine-readable — it is what retrieval matches on.",
      "properties": {
        "criteres_qualite": {
          "items": {
            "type": "string"
          },
          "title": "Criteres Qualite",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "muscles": {
          "items": {
            "type": "string"
          },
          "title": "Muscles",
          "type": "array"
        },
        "nom": {
          "title": "Nom",
          "type": "string"
        },
        "prerequis": {
          "items": {
            "type": "string"
          },
          "title": "Prerequis",
          "type": "array"
        },
        "progressions": {
          "description": "Harder variants, by entry id.",
          "items": {
            "type": "string"
          },
          "title": "Progressions",
          "type": "array"
        },
        "regressions": {
          "description": "Easier variants, by entry id.",
          "items": {
            "type": "string"
          },
          "title": "Regressions",
          "type": "array"
        },
        "tags": {
          "description": "Machine-readable needs this exercise addresses, e.g. 'rom_short', 'kipping', 'scapular_control'. Retrieval matches on these.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "nom",
        "muscles",
        "criteres_qualite",
        "tags"
      ],
      "title": "ExerciseEntry",
      "type": "object"
    },
    "FormScores": {
      "additionalProperties": false,
      "description": "Continuous quality scores for one repetition.\n\nEach field is a magnitude of deviation normalised to [0, 1], where 1.0 means\n\"no deviation detected\". A rule never returns a boolean: the coaching layer\nneeds to say \"tu ne descends pas assez bas\" with a degree, not \"rep invalide\".",
      "properties": {
        "alignment": {
          "description": "1.0 = trunk/shoulder alignment held through the rep.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Alignment",
          "type": "number"
        },
        "kipping": {
          "description": "1.0 = no parasitic hip momentum. Derived from pelvis acceleration orthogonal to the movement axis.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Kipping",
          "type": "number"
        },
        "rom": {
          "description": "Fraction of the athlete's calibrated range reached.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Rom",
          "type": "number"
        },
        "symmetry": {
          "description": "1.0 = identical left/right joint angles through the rep.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Symmetry",
          "type": "number"
        },
        "tempo_control": {
          "description": "1.0 = smooth, controlled velocity profile; low = jerky.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tempo Control",
          "type": "number"
        }
      },
      "required": [
        "rom",
        "symmetry",
        "kipping",
        "tempo_control",
        "alignment"
      ],
      "title": "FormScores",
      "type": "object"
    },
    "HistoryPoint": {
      "additionalProperties": false,
      "description": "One past session, compressed to what the coach actually needs.",
      "properties": {
        "date": {
          "format": "date-time",
          "title": "Date",
          "type": "string"
        },
        "exercise": {
          "$ref": "#/$defs/Exercise"
        },
        "mean_form": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Form",
          "type": "number"
        },
        "mean_rom": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Rom",
          "type": "number"
        },
        "total_reps": {
          "minimum": 0,
          "title": "Total Reps",
          "type": "integer"
        },
        "valid_reps": {
          "minimum": 0,
          "title": "Valid Reps",
          "type": "integer"
        }
      },
      "required": [
        "date",
        "exercise",
        "total_reps",
        "valid_reps",
        "mean_rom",
        "mean_form"
      ],
      "title": "HistoryPoint",
      "type": "object"
    },
    "RepEvent": {
      "additionalProperties": false,
      "description": "The central contract. Every counted repetition produces one of these.\n\nNothing in the system increments a bare counter: fatigue tracking, progression,\nperiodisation and the LLM coach are all built on the stream of RepEvents.",
      "properties": {
        "confidence": {
          "description": "Fraction of frames in this rep whose driving landmarks were above the visibility threshold. Below ~0.7, corrections are suppressed.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "counted": {
          "description": "Whether this rep counts toward the valid total. A rep can be recorded with poor scores and still count; `counted=False` is reserved for reps that failed the hard ROM floor.",
          "title": "Counted",
          "type": "boolean"
        },
        "duration_ms": {
          "exclusiveMinimum": 0.0,
          "title": "Duration Ms",
          "type": "number"
        },
        "exercise": {
          "$ref": "#/$defs/Exercise"
        },
        "flags": {
          "description": "Machine-readable issue codes, e.g. 'rom_short', 'kipping', 'left_lag'. Rendered to French by the UI, not stored in French.",
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "min_angle_deg": {
          "title": "Min Angle Deg",
          "type": "number"
        },
        "peak_angle_deg": {
          "title": "Peak Angle Deg",
          "type": "number"
        },
        "rep_index": {
          "description": "0-based index within the set.",
          "minimum": 0,
          "title": "Rep Index",
          "type": "integer"
        },
        "scores": {
          "$ref": "#/$defs/FormScores"
        },
        "started_at_ms": {
          "description": "Monotonic clock offset from session start, in milliseconds.",
          "title": "Started At Ms",
          "type": "number"
        },
        "tempo": {
          "$ref": "#/$defs/Tempo"
        }
      },
      "required": [
        "rep_index",
        "exercise",
        "started_at_ms",
        "duration_ms",
        "tempo",
        "scores",
        "peak_angle_deg",
        "min_angle_deg",
        "confidence",
        "counted"
      ],
      "title": "RepEvent",
      "type": "object"
    },
    "SessionSummary": {
      "additionalProperties": false,
      "description": "Aggregated, image-free payload. This — and only this — is what may be sent\nto the Anthropic API.",
      "properties": {
        "athlete_id": {
          "title": "Athlete Id",
          "type": "string"
        },
        "duration_s": {
          "minimum": 0.0,
          "title": "Duration S",
          "type": "number"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "perceived_effort": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RPE, self-reported.",
          "title": "Perceived Effort"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "sets": {
          "items": {
            "$ref": "#/$defs/SetSummary"
          },
          "title": "Sets",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "athlete_id",
        "started_at",
        "duration_s",
        "sets"
      ],
      "title": "SessionSummary",
      "type": "object"
    },
    "SetSummary": {
      "additionalProperties": false,
      "properties": {
        "exercise": {
          "$ref": "#/$defs/Exercise"
        },
        "reps": {
          "items": {
            "$ref": "#/$defs/RepEvent"
          },
          "title": "Reps",
          "type": "array"
        }
      },
      "required": [
        "exercise",
        "reps"
      ],
      "title": "SetSummary",
      "type": "object"
    },
    "Tempo": {
      "additionalProperties": false,
      "description": "Phase durations in seconds. Mirrors the usual eccentric/pause/concentric\nnotation used in strength programming.",
      "properties": {
        "bottom_pause_s": {
          "minimum": 0.0,
          "title": "Bottom Pause S",
          "type": "number"
        },
        "concentric_s": {
          "minimum": 0.0,
          "title": "Concentric S",
          "type": "number"
        },
        "eccentric_s": {
          "minimum": 0.0,
          "title": "Eccentric S",
          "type": "number"
        },
        "top_pause_s": {
          "minimum": 0.0,
          "title": "Top Pause S",
          "type": "number"
        }
      },
      "required": [
        "eccentric_s",
        "bottom_pause_s",
        "concentric_s",
        "top_pause_s"
      ],
      "title": "Tempo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Assembled server-side and rendered into the user turn. No raw landmarks,\nno imagery, ever.",
  "properties": {
    "athlete": {
      "$ref": "#/$defs/AthleteProfile"
    },
    "catalogue": {
      "description": "Exercise entries retrieved for this session's detected weaknesses. Keeps the coach's suggestions anchored to a real catalogue instead of invented movement names.",
      "items": {
        "$ref": "#/$defs/ExerciseEntry"
      },
      "maxItems": 12,
      "title": "Catalogue",
      "type": "array"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistoryPoint"
      },
      "maxItems": 30,
      "title": "History",
      "type": "array"
    },
    "session": {
      "$ref": "#/$defs/SessionSummary"
    }
  },
  "required": [
    "athlete",
    "session"
  ],
  "title": "CoachRequest",
  "type": "object"
}

# Copy to .env and fill in. Never commit .env.
#
# Without this key the app still counts reps and scores form entirely on-device;
# only the LLM debrief is unavailable. That is the intended offline-first
# behaviour, not a degraded mode.
ANTHROPIC_API_KEY=

# Optional overrides
# IACOACH_DB_URL=sqlite:///./iacoach.db
# IACOACH_SESSION_MODEL=claude-sonnet-5
# IACOACH_PLANNING_MODEL=claude-opus-4-8

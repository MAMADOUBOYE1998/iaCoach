{
  "name": "iacoach-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iaCoach PWA: camera capture, on-device pose, rep counting and form scoring.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vendor-assets": "node scripts/vendor-assets.mjs",
    "make-icons": "node scripts/make-icons.mjs",
    "check:sw": "node scripts/check-sw.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
